# ── Сервер ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Публічний URL, який гості вставляють у Claude/ChatGPT
PUBLIC_URL=https://mcp.rutapolyana.com

# ── Готель ───────────────────────────────────────────────────────────────────
HOTEL_NAME=Ruta Resort Polyana
HOTEL_SITE=https://rutapolyana.com
HOTEL_PHONE=+380 67 265 74 00
HOTEL_EMAIL=polyana@rutahnr.com
HOTEL_CURRENCY=UAH
HOTEL_TIMEZONE=Europe/Kyiv

# ── CRM ──────────────────────────────────────────────────────────────────────
# mock — демо-дані (працює одразу, без CRM)
# rest — реальна CRM по HTTP-контракту з README
CRM_PROVIDER=mock
CRM_BASE_URL=https://crm.example.com/api/v1
CRM_API_KEY=
CRM_AUTH_HEADER=Authorization
CRM_AUTH_SCHEME=Bearer
CRM_HOTEL_ID=
CRM_TIMEOUT_MS=12000

# ── Ліміти ───────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_ADVANCE_DAYS=400
MAX_NIGHTS=30
