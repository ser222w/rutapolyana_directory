{
  "name": "rutapolyana-mcp-booking",
  "version": "1.0.0",
  "description": "MCP-сервер бронювання Ruta Resort Polyana — гості бронюють через Claude/ChatGPT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
